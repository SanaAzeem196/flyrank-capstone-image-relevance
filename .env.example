# Gemini (free tier, no credit card): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
VISION_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768

# Database
DATABASE_URL=postgresql+psycopg://capstone:capstone@db:5432/capstone

# Worker limits (set GEMINI_RPM from your real limits at aistudio.google.com/rate-limit)
GEMINI_RPM=10
MAX_CALLS_PER_RUN=300
MAX_EST_USD=1.00
JOB_MAX_ATTEMPTS=3

# Mismatch guard (placeholders; SIM_MIN is tuned on the eval set in Phase 4)
CONF_MIN=0.70
SIM_MIN=0.60

# Tenancy
DEFAULT_TENANT_ID=demo

LOG_LEVEL=INFO